{
  "name": "stack-atlas-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "dev:container": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "npm run content:validate && next build",
    "start": "node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:precommit": "node scripts/validate-local-ci.mjs",
    "content:validate": "node --import tsx scripts/content-validate.ts",
    "audit:content": "node --import tsx scripts/audit-duplicates.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.3.6",
    "parse5": "^8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
