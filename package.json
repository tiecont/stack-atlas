{
  "name": "stack-atlas-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-next.mjs dev",
    "build": "node scripts/prepare-next.mjs build",
    "content:build": "node scripts/prepare-next.mjs",
    "start": "node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
